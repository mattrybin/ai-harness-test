#!/usr/bin/env bash
# Run a local whisper.cpp server that speaks the OpenAI transcription API.
# macOS only. `make stt` starts it, `make stt-model` only fetches the model.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
port="${STT_PORT:-8124}"
model="$root/models/ggml-large-v3-turbo.bin"
# From the LFS pointer at https://huggingface.co/ggerganov/whisper.cpp
sha256="1fc70f774d38eb169993ac391eea357ef47c88757ef72ee5943879b7e8e2bc69"
url="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin"

echo "stt: port=$port model=${model#"$root/"}"

for bin in whisper-server ffmpeg; do
  if ! command -v "$bin" >/dev/null; then
    echo "stt: $bin not found. Install: brew install whisper-cpp ffmpeg" >&2
    exit 1
  fi
done

checksum() { shasum -a 256 "$1" | cut -d' ' -f1; }

if [ -f "$model" ] && [ "$(checksum "$model")" = "$sha256" ]; then
  echo "stt: sha256 ok"
else
  [ -f "$model" ] && echo "stt: model fails sha256, downloading again"
  echo "stt: downloading model (1.6 GB) ..."
  mkdir -p "$(dirname "$model")"
  curl -L --fail --progress-bar -o "$model.part" "$url"
  got="$(checksum "$model.part")"
  if [ "$got" != "$sha256" ]; then
    echo "stt: sha256 mismatch, got $got" >&2
    rm -f "$model.part"
    exit 1
  fi
  mv "$model.part" "$model"
  echo "stt: sha256 ok"
fi

[ "${1:-}" = "--model-only" ] && exit 0

echo "stt: listening on http://127.0.0.1:$port"
exec whisper-server --model "$model" --port "$port" --inference-path /v1/audio/transcriptions --convert
